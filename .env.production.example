# ==============================================================================
# Production Environment Variables Template: Australian Dealer SaaS
# ==============================================================================
# Copy this file to .env.production on your production server / container runner.
# Ensure all secrets are rotated, encrypted, and injected via your secrets manager (e.g. AWS Secrets Manager, Doppler, Infisical).

# ------------------------------------------------------------------------------
# 1. Core Application & Canonical Domain Routing
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
NEXT_TELEMETRY_DISABLED=1

# Root platform URL and domain
NEXT_PUBLIC_APP_URL=https://apexautos.com.au
NEXT_PUBLIC_PLATFORM_DOMAIN=apexautos.com.au

# ------------------------------------------------------------------------------
# 2. Supabase Multi-Tenant Database (Sydney Region: ap-southeast-2)
# ------------------------------------------------------------------------------
# CRITICAL: Always provision in Sydney (ap-southeast-2) for <15ms latency to AU dealerships.
NEXT_PUBLIC_SUPABASE_URL=https://prod-db.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
DATABASE_URL=postgresql://postgres.prod-db:StrongPassword@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?sslmode=require

# ------------------------------------------------------------------------------
# 3. Media Storage: Cloudflare R2 (Sydney Edge) / AWS S3
# ------------------------------------------------------------------------------
# S3-compatible portable credentials
R2_ACCOUNT_ID=cloudflare_account_id_hex
R2_ACCESS_KEY_ID=r2_access_key_id
R2_SECRET_ACCESS_KEY=r2_secret_access_key
R2_BUCKET_NAME=dealer-media-prod
R2_PUBLIC_DOMAIN=https://media.apexautos.com.au
NEXT_PUBLIC_R2_PUBLIC_URL=https://media.apexautos.com.au
USE_AWS_S3=false
AWS_REGION=ap-southeast-2

# ------------------------------------------------------------------------------
# 4. Security, Bot Protection & Rate Limiting
# ------------------------------------------------------------------------------
# Cloudflare Turnstile (Managed Challenge)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAx...
TURNSTILE_SECRET_KEY=0x4AAAAAAAx...
CLOUDFLARE_TURNSTILE_SECRET_KEY=0x4AAAAAAAx...

# Upstash Redis Serverless (Sydney / AP region)
UPSTASH_REDIS_REST_URL=https://sydney-dealer-cache.upstash.io
UPSTASH_REDIS_REST_TOKEN=AX_prod_token...
RATE_LIMIT_HMAC_SECRET=c8d4e9f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9

# ------------------------------------------------------------------------------
# 5. Billing & Invoicing: Stripe Australia (AUD, 10% GST)
# ------------------------------------------------------------------------------
# Live keys from Australian Pty Ltd Stripe Account
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
