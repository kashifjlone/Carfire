# Environment Variables Template
# Copy this file to .env.local for development

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PLATFORM_DOMAIN=platform.com.au

# Supabase (Sydney Region: ap-southeast-2)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-migrations-only
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres

# Cloudflare R2 (or AWS S3)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=australian-dealer-saas-media
R2_PUBLIC_DOMAIN=https://media.platform.com.au
# Set to 'true' if using native AWS S3 instead of Cloudflare R2
USE_AWS_S3=false
AWS_REGION=ap-southeast-2

# Upstash Redis (Rate Limiting & Queue)
UPSTASH_REDIS_REST_URL=https://your-upstash.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
RATE_LIMIT_HMAC_SECRET=generate-a-secure-random-32-byte-hex-secret

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Stripe Australia (AUD, 10% GST)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
